# ============================================================
# MĪZĀN AL-ḤADĪTH — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# NEVER commit real credentials to version control.
# Copy this file to .env and fill in your private credentials.

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here

# Backend Server Configuration (Optional)
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development

# LLM Providers (Optional for Ask Mīzān online synthesis)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Semantic Retrieval Configuration (Default: gemini; Experimental: embeddinggemma2)
SEMANTIC_EMBEDDING_PROVIDER=gemini
